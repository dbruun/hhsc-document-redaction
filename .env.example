# Azure AD tenant that owns the Cognitive Services + Storage resources
AZURE_TENANT_ID=<your-tenant-id>

# Azure AI Language resource endpoint (text PII detection)
AZURE_LANGUAGE_ENDPOINT=https://<your-language-resource>.cognitiveservices.azure.com

# Azure AI Document Intelligence endpoint (required for PDF word coordinates)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-doc-intel-resource>.cognitiveservices.azure.com

# Blob storage (identity-based auth; no account key)
AZURE_STORAGE_SERVICE_URI=https://<your-account>.blob.core.windows.net
AZURE_STORAGE_UNREDACTED_CONTAINER_NAME=documents-unredacted
AZURE_STORAGE_REDACTED_CONTAINER_NAME=documents-redacted
